---
import '../styles/global.css';
import { SITE_NAME } from '../config.js';
import { HOME_PATH, HTML_LANG, STRINGS as t, archivePath } from '../site/strings.js';
import { OG_HEIGHT, OG_WIDTH } from '../site/og-image.js';
import { ADSENSE_CLIENT, AMAZON_DISCLOSURE, AMAZON_TAG, CF_ANALYTICS_TOKEN } from '../site/settings.js';

interface Props {
  title?: string;
  description?: string;
  /** Separador ativo no topo. */
  tab?: 'today' | 'archive' | 'read' | 'write' | 'support';
  /** Data ISO de publicação, nas páginas de cada dia (Open Graph do tipo article). */
  published?: string;
  /** Imagem de partilha (caminho no site); por omissão, a imagem geral. */
  image?: string;
  imageAlt?: string;
}

const { title, description, tab, published, image = '/og/site.png', imageAlt = SITE_NAME } = Astro.props;
const metaDescription = description ?? t.tagline;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={HTML_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} (RSS)`} href="/feed.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:locale" content="en_GB" />
    {published && <meta property="article:published_time" content={published} />}
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      ADSENSE_CLIENT && (
        <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />
      )
    }
    {
      CF_ANALYTICS_TOKEN && (
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })} />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <p class="site-name"><a href={HOME_PATH}>{SITE_NAME}</a></p>
        <nav class="tabs" aria-label={t.sections}>
          <ul>
            <li><a href={HOME_PATH} aria-current={tab === 'today' ? 'page' : undefined}>{t.today}</a></li>
            <li><a href={archivePath()} aria-current={tab === 'archive' ? 'page' : undefined}>{t.archive}</a></li>
            <li><a href="/read/" aria-current={tab === 'read' ? 'page' : undefined}>Read</a></li>
            <li><a href="/write/" aria-current={tab === 'write' ? 'page' : undefined}>Write</a></li>
            <li><a href="/support/" aria-current={tab === 'support' ? 'page' : undefined}><span class="label-long">Buy me a coffee</span><span class="label-short" aria-hidden="true">Coffee</span></a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="About this site">
          <ul>
            <li><a href="/bradbury-challenge/">What is the Bradbury Challenge?</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/feed.xml">RSS</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/cookies/">Cookies</a></li>
            <li><a href="/contact/">Contact</a></li>
            {
              ADSENSE_CLIENT && (
                <li>
                  <button type="button" class="link-button" data-privacy-settings>
                    Privacy settings
                  </button>
                </li>
              )
            }
          </ul>
        </nav>
        {AMAZON_TAG && <p class="footer-note">{AMAZON_DISCLOSURE}</p>}
      </div>
    </footer>
    <script>
      import { initReadMarks } from '../site/read-marks.ts';
      initReadMarks();
      // Reabre a mensagem de consentimento do Google (plataforma de consentimento do AdSense).
      document.querySelector('[data-privacy-settings]')?.addEventListener('click', () => {
        const w = window as unknown as { googlefc?: { callbackQueue?: unknown[]; showRevocationMessage?: () => void } };
        w.googlefc = w.googlefc || {};
        w.googlefc.callbackQueue = w.googlefc.callbackQueue || [];
        w.googlefc.callbackQueue.push(() => w.googlefc?.showRevocationMessage?.());
      });
    </script>
  </body>
</html>
