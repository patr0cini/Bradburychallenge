---
import '../styles/global.css';
import { SITE_NAME } from '../config.js';
import { HOME_PATH, HTML_LANG, STRINGS as t, archivePath } from '../site/strings.js';
import { ADSENSE_CLIENT, CF_ANALYTICS_TOKEN } from '../site/settings.js';

interface Props {
  title?: string;
  description?: string;
  /** Separador ativo no topo. */
  tab?: 'today' | 'archive';
}

const { title, description, tab } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={HTML_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t.tagline} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      ADSENSE_CLIENT && (
        <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />
      )
    }
    {
      CF_ANALYTICS_TOKEN && (
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })} />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <p class="site-name"><a href={HOME_PATH}>{SITE_NAME}</a></p>
        <nav class="tabs" aria-label={t.sections}>
          <ul>
            <li><a href={HOME_PATH} aria-current={tab === 'today' ? 'page' : undefined}>{t.today}</a></li>
            <li><a href={archivePath()} aria-current={tab === 'archive' ? 'page' : undefined}>{t.archive}</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="About this site">
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/cookies/">Cookies</a></li>
            <li><a href="/contact/">Contact</a></li>
            {
              ADSENSE_CLIENT && (
                <li>
                  <button type="button" class="link-button" data-privacy-settings>
                    Privacy settings
                  </button>
                </li>
              )
            }
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      import { initReadMarks } from '../site/read-marks.ts';
      initReadMarks();
      // Reabre a mensagem de consentimento do Google (plataforma de consentimento do AdSense).
      document.querySelector('[data-privacy-settings]')?.addEventListener('click', () => {
        const w = window as unknown as { googlefc?: { callbackQueue?: unknown[]; showRevocationMessage?: () => void } };
        w.googlefc = w.googlefc || {};
        w.googlefc.callbackQueue = w.googlefc.callbackQueue || [];
        w.googlefc.callbackQueue.push(() => w.googlefc?.showRevocationMessage?.());
      });
    </script>
  </body>
</html>
