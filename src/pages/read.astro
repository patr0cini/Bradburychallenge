---
import Base from '../layouts/Base.astro';
import RecommendationList from '../components/RecommendationList.astro';
import { READ } from '../site/recommendations.js';
---

<Base tab="read" title="Read" description="Books to keep the challenge going: Ray Bradbury, short story collections, poetry anthologies and essays.">
  <h1 class="page-title">Read</h1>
  <p class="page-lead">
    The daily readings are free online. When you want a book in your hands, these are good companions for the challenge:
    Bradbury himself, and collections of the three forms he told us to read.
  </p>
  <RecommendationList groups={READ} />
</Base>
