---
import Base from '../layouts/Base.astro';
import DayView from '../components/DayView.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { START_DATE } from '../config.js';
import { addDays } from '../lib/dates.js';
import { loadSiteData } from '../site/data.js';
import { STRINGS as t, archivePath, dayPath, formatLongDate } from '../site/strings.js';

const { days, today } = loadSiteData();
const day = days.at(-1);
const previous = days.at(-2);
// No momento do build a seleção de hoje pode ainda não existir: mostra-se a mais recente.
const builtStale = day && day.date < today;
const olderText = day ? t.staleOlder(formatLongDate(day.date)) : '';
const staticText = day && day.date === addDays(today, -1) ? t.staleYesterday : olderText;
---

<Base tab="today" description={t.homeDescription} image={day ? `/og/${day.date}.png` : undefined}>
  {
    day ? (
      <DayView day={day} showNumber={false}>
        <p
          slot="notice"
          class="notice"
          data-stale-check={day.date}
          data-yesterday-text={t.staleYesterday}
          data-older-text={olderText}
          data-static={builtStale ? '1' : undefined}
          hidden={!builtStale}
        >
          {builtStale ? staticText : ''}
        </p>
        <p class="quiet-links">
          {previous && (
            <>
              <a href={dayPath(previous.date)}>{t.yesterdayLink}</a> ·{' '}
            </>
          )}
          <a href={archivePath()}>{t.archive}</a> ·{' '}
          <a href="/bradbury-challenge/">What is the Bradbury Challenge?</a>
        </p>
        <NewsletterForm />
      </DayView>
    ) : (
      <>
        <h1 class="page-title">{t.notStartedTitle}</h1>
        <p class="empty">{t.notStarted(formatLongDate(START_DATE))}</p>
      </>
    )
  }
</Base>
