---
import Base from '../layouts/Base.astro';
import RecommendationList from '../components/RecommendationList.astro';
import { WRITE } from '../site/recommendations.js';
---

<Base tab="write" title="Write" description="Notebooks, fountain pens and ink for your notes and drafts.">
  <h1 class="page-title">Write</h1>
  <p class="page-lead">
    Bradbury's advice was meant for writers: read widely so that you have something to write with. Some simple tools for
    getting words down.
  </p>
  <RecommendationList groups={WRITE} />
</Base>
